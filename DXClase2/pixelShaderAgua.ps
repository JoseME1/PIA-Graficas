struct Light 
{
	float3 direction;
	float specularPower;
	float4 ambient;
	float4 diffuse;
	float4 specular;
};

cbuffer ConstantBufferPS
{
	Light light;
	float Time;
	float3 pad;
};

Texture2D ObjTex;
SamplerState ObjSamplerState;


struct VS_OUTPUT 
{
	float4 Pos : SV_POSITION;
	float2 TexCoord : TEXTURE;
	float3 normal : NORMAL;
	float3 viewDirection : COORDS;
	float3 tangent : TANGENT;
	float3 binormal : BINORMAL;
    float4 vectPos : POSITION;
    float maxHeight : HEIGHT;
    float3 worldPos : WORLDPOS;
float fogDist : FOGDIST;

};

float4 PS( VS_OUTPUT input ) : SV_Target
{
    float3 L = normalize(light.direction);
    float3 V = normalize(input.viewDirection);

    float wave = sin((input.TexCoord.x + input.TexCoord.y) * 1.2f + Time * 6.0f);

    float3 N = normalize(float3(wave * 0.3f, 1.0f, wave * 0.3f));

    float diff = saturate(dot(N, L));

    float3 H = normalize(L + V);
    float spec = pow(saturate(dot(N, H)), 32.0f);
    if (diff <= 0.0f) spec = 0.0f;

    float3 deepColor = float3(0.0f, 0.28f, 0.45f);
    float3 shallowColor = float3(0.0f, 0.42f, 0.60f);
    float3 waterColor = lerp(deepColor, shallowColor, wave * 0.5f + 0.5f);

    float2 scrollUV = input.TexCoord * 0.5f + float2(Time * 0.2f, Time * 0.12f);
    float4 texColor = ObjTex.Sample(ObjSamplerState, scrollUV);
    waterColor = lerp(waterColor, texColor.rgb * waterColor, 0.5f);


    float3 finalColor = waterColor * light.ambient.rgb;
    finalColor += waterColor * light.diffuse.rgb * diff;
    finalColor += light.specular.rgb * spec * 0.3f;
    float fogDensity = 0.015f;
float fogHeightFalloff = 0.08f;
float fogBaseHeight = 3.0f;
float heightFactor = exp(-max(input.worldPos.y - fogBaseHeight, 0.0f) * fogHeightFalloff);
float fogFactor = 1.0f - exp(-fogDensity * input.fogDist * heightFactor);
fogFactor = saturate(fogFactor);
float3 fogColor = float3(0.55f, 0.6f, 0.65f) * (light.ambient.rgb + light.diffuse.rgb * 0.5f);
finalColor = lerp(finalColor, fogColor, fogFactor);


    return float4(finalColor, 1.0f);
}
