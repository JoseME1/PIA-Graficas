struct Light
{
	float3 direction;
	float specularPower;
	float4 ambient;
	float4 diffuse;
	float4 specular;
};

cbuffer ConstantBufferPS
{
	Light light;
};

struct VS_OUTPUT
{
	float4 Pos : SV_POSITION;
	float2 TexCoord : TEXTURE;
	float3 normal : NORMAL;
	float3 viewDirection : COORDS;
	float3 tangent : TANGENT;
	float3 binormal : BINORMAL;
	float4 vectPos : POSITION;
	float maxHeight : HEIGHT;
	float3 worldPos : WORLDPOS;
	float fogDist : FOGDIST;

};

Texture2D ObjTexture;
Texture2D ObjTexture2;
Texture2D ObjTexture3;
SamplerState ObjSamplerState;

float4 PS( VS_OUTPUT input ) : SV_Target
{
	input.normal = normalize(input.normal);

	float4 textureColor = ObjTexture.Sample( ObjSamplerState, input.TexCoord );
	float4 textureColor2 = ObjTexture2.Sample( ObjSamplerState, input.TexCoord );
	float4 textureColor3 = ObjTexture3.Sample( ObjSamplerState, input.TexCoord );

	float l = saturate((input.vectPos.y - 1.0) / 3.0);
	textureColor *= l * 0.5;
	textureColor2 *= (1.0 - l) * 0.5;
	textureColor3 *= 0.5;

	textureColor += textureColor2 + textureColor3;

	float3 N = float3(0.0f, 1.0f, 0.0f);
	float3 L = normalize(light.direction);
	float3 V = normalize(input.viewDirection);

	float diff = saturate(dot(N,L));

	float3 H = normalize(L+V);
	float spec = pow(saturate(dot(N,H)), light.specularPower);
	if (diff<=0.0f) spec = 0.0f;

	float3 finalColor = textureColor.rgb * light.ambient.rgb;
	finalColor += textureColor.rgb * light.diffuse.rgb * diff;
	finalColor += light.specular.rgb * spec * 0.05f;

	float fogDensity = 0.015f;
float fogHeightFalloff = 0.08f;
float fogBaseHeight = 3.0f;
float heightFactor = exp(-max(input.worldPos.y - fogBaseHeight, 0.0f) * fogHeightFalloff);
float fogFactor = 1.0f - exp(-fogDensity * input.fogDist * heightFactor);
fogFactor = saturate(fogFactor);
float3 fogColor = float3(0.80f, 0.36f, 0.22f) * (light.ambient.rgb + light.diffuse.rgb * 0.5f);
finalColor = lerp(finalColor, fogColor, fogFactor);


	return float4(finalColor,1);
}